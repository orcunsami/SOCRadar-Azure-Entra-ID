# SOCRadar Entra ID Integration — App Settings
# Copy to .env and fill in values (for local testing only)

# SOCRadar API
SOCRADAR_BASE_URL=https://platform.socradar.com    # preprod: https://preprod.socradar.com
SOCRADAR_API_KEY=your_platform_api_key_here
SOCRADAR_COMPANY_ID=your-company-id

# Entra ID App Registration (identifiers only — NO secret)
# Graph auth uses Workload Identity Federation: UAMI → FIC → App Registration
# Permissions managed in portal (App Registration → API permissions → Grant admin consent)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-registration-client-id

# Entra ID Security Group (for ENABLE_ADD_TO_GROUP)
SECURITY_GROUP_ID=

# Log Analytics ingestion (Data Collection Rule; set automatically by ARM template)
DCR_ENDPOINT=https://your-dce.region.ingest.monitor.azure.com
DCR_IMMUTABLE_ID=dcr-xxxxxxxxxxxxxxxx

# Storage Account (checkpoint state — set automatically by ARM template)
STORAGE_ACCOUNT_NAME=

# Source toggles (true/false)
ENABLE_BOTNET_SOURCE=true
ENABLE_PII_SOURCE=true
ENABLE_VIP_SOURCE=false   # UNVERIFIED endpoint

# Action toggles
ENABLE_USER_LOOKUP=true             # if false, User.Read.All is not required and Entra actions are skipped
ENABLE_ROPC=false                    # password validation via ROPC (discouraged by MS)
ENABLE_REVOKE_SESSION=true
ENABLE_ADD_TO_GROUP=false
ENABLE_REMOVE_FROM_GROUP=false       # reverse of AddToGroup
ENABLE_PASSWORD_CHANGE=false
ENABLE_DISABLE_ACCOUNT=false
ENABLE_ENABLE_ACCOUNT=false          # reverse of DisableAccount
ENABLE_CONFIRM_RISKY=false           # requires Entra ID P1/P2
ENABLE_FORCE_MFA_REREGISTRATION=false   # HIGH IMPACT — deletes all non-password auth methods
ENABLE_CREATE_INCIDENT=false
ENABLE_RESOLVE_ALARM=false                # auto-resolve SOCRadar alarms when user found in Entra ID

# Password logging (false = sanitized only, true = plaintext written to LAW)
ENABLE_LOG_PLAINTEXT_PASSWORD=false

# Polling schedule (6-field NCRONTAB: second minute hour day month day-of-week)
POLLING_SCHEDULE=0 0 */6 * * *

# Initial lookback for first run (minutes)
INITIAL_LOOKBACK_MINUTES=43200
INITIAL_START_DATE=                  # YYYY-MM-DD, overrides lookback if set

# Microsoft Sentinel workspace (only required if ENABLE_CREATE_INCIDENT=true)
SUBSCRIPTION_ID=
WORKSPACE_NAME=
WORKSPACE_LOCATION=
WORKSPACE_RESOURCE_GROUP=

# Azure deployment
RESOURCE_GROUP=your-resource-group
LOCATION=northeurope

# UAMI (set automatically by ARM template; needed for local testing with User-Assigned Managed Identity)
# AZURE_CLIENT_ID=your-uami-client-id
